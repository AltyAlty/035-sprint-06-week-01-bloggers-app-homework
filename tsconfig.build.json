{
  /*Наследуем все настройки из основного конфига "tsconfig.json".*/
  "extends": "./tsconfig.json",
  /*Переопределяем корень исходных файлов, чтобы в папку "dist" попал только код приложения.*/
  "compilerOptions": { "rootDir": "src" },
  /*Указываем какие папки компилятор должен игнорировать.*/
  "exclude": ["dist", "node_modules", "test", "**/*spec.ts", "__tests__/**/*"]
}
